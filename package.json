{
  "name": "@spearwolf/signalize",
  "version": "1.0.0-dev",
  "description": "signals and effects for all",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "lib/**/*.d.ts",
    "docs",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decorators": {
      "types": "./lib/decorators.d.ts",
      "import": "./dist/decorators.js"
    }
  },
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "update": "npx npm-check-updates -u",
    "publish:pkg": "node scripts/publishPackage.cjs",
    "checkPkgTypes": "attw --pack --profile esm-only",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile": "run-s -sn compile:js compile:types",
    "compile:js": "tsc --project tsconfig.lib.json",
    "compile:types": "tsc --project tsconfig.types.json",
    "bundle": "rollup -c rollup.config.mjs",
    "clean": "rimraf build types tests dist lib coverage smoke/build",
    "lint": "biome lint",
    "format": "biome format",
    "format:write": "biome format --write",
    "check": "biome check",
    "fix": "biome check --write",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:gc": "vitest run --config vitest.gc.config.ts",
    "test:smoke": "rimraf smoke/build && tsc --project smoke/tsconfig.json && node -e \"const g=require('node:fs').globSync('smoke/build/*.test.js');if(g.length===0){console.error('[test:smoke] no files matched smoke/build/*.test.js after compiling smoke/ - a smoke test file was likely renamed off the *.test.ts convention (tsc alone cannot catch this, and a stale smoke/build/ would have masked it too)');process.exit(1)}\" && node --test \"smoke/build/*.test.js\"",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "cbt": "run-s -sn clean compile bundle test",
    "dist": "run-s -sn clean compile bundle",
    "smoke": "run-s -sn dist test:smoke",
    "world": "run-s -sn clean check typecheck compile bundle test:smoke checkPkgTypes test test:gc"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@spearwolf/eventize": "^6.0.0",
    "@swc/core": "^1.15.46",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "npm-run-all2": "^9.0.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@spearwolf/eventize": "^6.0.0"
  },
  "homepage": "https://github.com/spearwolf/signalize/",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/signalize.git"
  },
  "bugs": {
    "url": "https://github.com/spearwolf/signalize/issues"
  },
  "author": {
    "name": "Wolfger Schramm",
    "email": "wolfger@spearwolf.de",
    "url": "https://www.spearwolf.de"
  },
  "packageManager": "pnpm@11.20.0"
}
