{
  "name": "@spearwolf/signalize",
  "version": "0.29.0",
  "description": "signals and effects for all",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/index.js"
    },
    "./decorators": {
      "types": "./lib/decorators.d.ts",
      "import": "./dist/decorators.js"
    }
  },
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "update": "npx npm-check-updates -u",
    "publish:pkg": "node scripts/publishPackage.cjs",
    "checkPkgTypes": "attw --pack",
    "compile": "tsc --project tsconfig.lib.json",
    "bundle": "rollup -c rollup.config.mjs",
    "clean": "rimraf build types tests dist lib",
    "lint": "biome lint",
    "format": "biome format",
    "format:write": "biome format --write",
    "check": "biome check",
    "fix": "biome check --write",
    "jest:debug": "cross-env NODE_ENV=test node --nolazy --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --colors --verbose",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:gc": "cross-env NODE_ENV=test NODE_OPTIONS=--expose-gc jest --runInBand",
    "cbt": "run-s -sn clean compile bundle test",
    "dist": "run-s -sn clean compile bundle",
    "world": "run-s -sn clean check compile bundle test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.15",
    "@spearwolf/eventize": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/sinon": "^21.0.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "jest-expect-message": "^1.1.3",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "sinon": "^22.0.0",
    "ts-jest": "^29.4.10",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@spearwolf/eventize": "^5.0.0"
  },
  "homepage": "https://github.com/spearwolf/signalize/",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spearwolf/signalize.git"
  },
  "bugs": {
    "url": "https://github.com/spearwolf/signalize/issues"
  },
  "author": {
    "name": "Wolfger Schramm",
    "email": "wolfger@spearwolf.de",
    "url": "https://www.spearwolf.de"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
