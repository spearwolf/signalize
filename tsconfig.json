{
  "include": ["src/**/*.ts", "vitest.config.ts", "vitest.gc.config.ts"],

  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "node"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "removeComments": true,

    "strict": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true
  }
}
