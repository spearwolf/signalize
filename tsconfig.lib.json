{
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/__testing__/**"],

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "lib",
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "lib",
    "declarationMap": true,
    "isolatedModules": true
  }
}
